{
  "name": "@omit/react-fancy-switch",
  "private": false,
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "description": "An accessible, animated switch / segmented control (radio group) component for React",
  "author": {
    "name": "Aslam H",
    "email": "iupin5212@gmail.com"
  },
  "homepage": "https://github.com/Aslam97/react-fancy-switch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aslam97/react-fancy-switch.git",
    "directory": "packages/react-fancy-switch"
  },
  "bugs": {
    "url": "https://github.com/Aslam97/react-fancy-switch/issues"
  },
  "keywords": [
    "react",
    "switch",
    "fancy",
    "radio",
    "toggle",
    "segmented-control"
  ],
  "sideEffects": false,
  "main": "./dist/react-fancy-switch.cjs",
  "module": "./dist/react-fancy-switch.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/react-fancy-switch.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/react-fancy-switch.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "unplugin-dts": "^1.1.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  }
}
